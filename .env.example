# CaseBreaker local environment template

# Backend / story generation. Set at least one provider key.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_EVIDENCE_IMAGE_MODEL=gpt-image-1

# Frontend proxy target for the FastAPI backend.
CASEBREAKER_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Optional voice / 3D providers.
ELEVENLABS_API_KEY=
TRIPO_API_KEY=
TRIPO_REMOTE_ENABLED=false
TRIPO_MANUAL_MODE=false

# Optional AWS Polly fallback for speech.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_POLLY_VOICE_ID=Amy
